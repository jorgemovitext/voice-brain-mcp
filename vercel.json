{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --workspace apps/api && npm run build --workspace apps/console",
  "outputDirectory": "apps/console/dist/console/browser",
  "installCommand": "npm install --workspaces --include-workspace-root",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "apps/api/dist/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/precall", "destination": "/api/index" },
    { "source": "/webhooks/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

# Copiá este archivo a `.env` en la raíz del monorepo.
# Con MOCK=true todo corre simulado, sin credenciales.
# En Vercel, estas mismas claves se cargan en Project → Settings → Environment Variables.

# --- Modo ---
MOCK=true
PORT=3000

# --- NL Pearl v2 ---
# Auth: header `Authorization: Bearer {AccountId}:{SecretKey}` (confirmado en docs)
# Acepta con o sin /v2 al final (los paths del cliente ya lo incluyen).
NLPEARL_BASE_URL=https://api.nlpearl.ai
NLPEARL_ACCOUNT_ID=
NLPEARL_API_KEY=
NLPEARL_PEARL_ID=
# Credential del webhook: NO lo da NL Pearl — lo creás VOS.
# El mismo valor va en dos lados: (1) NL Pearl → Pearl → PearlVibe →
# Outbound Settings → Webhooks → credential; (2) acá. Vacío = no se exige.
NLPEARL_WEBHOOK_SECRET=

# --- Canal de seguimiento post-llamada: whatsapp | sms ---
FOLLOWUP_CHANNEL=whatsapp

# --- WhatsApp vía Gupshup (BSP) — proveedor preferido si está completo ---
# Webhook a configurar en Gupshup → Webhooks:  https://<tu-host>/webhooks/gupshup
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
# Número emisor registrado, sin '+' (ej. 917834811114)
GUPSHUP_SOURCE_NUMBER=
# GUPSHUP_API_URL=https://api.gupshup.io/wa/api/v1/msg

# --- WhatsApp Cloud API (Meta directo) — alternativa a Gupshup ---
# Meta → tu App → WhatsApp → API Setup:
#   PHONE_NUMBER_ID: el "Phone number ID" del número emisor
#   TOKEN: access token (temporal de 24 h para probar, o permanente de System User)
# Con estas dos, el canal pasa de stub a envío real.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# Lo inventás vos; se pega igual en Meta → Webhooks → Verify token
WHATSAPP_VERIFY_TOKEN=
# Meta → App → Settings → Basic → App Secret (valida la firma de los eventos)
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Plantilla de saludo aprobada en Meta, para ABRIR conversación cuando el
# ciudadano nunca le escribió a nuestro número (WhatsApp solo permite texto
# libre dentro de la ventana de 24 h que abre un mensaje entrante). El texto
# exacto a registrar está en docs/plantilla-whatsapp.md. Acá va el ID que
# devuelve Gupshup al aprobarla, no el texto.
GUPSHUP_TEMPLATE_SALUDO=

# --- Umbral de escalamiento al despacho (E3_EXECUTIVE) ---
# Cuándo un incidente deja de ser un reporte más y despierta al alcalde.
# Escala por VOLUMEN (personas distintas reportando el mismo lugar) o por
# IMPACTO (el paso sigue bloqueado pasados N minutos). Los defaults son
# conservadores a propósito: el guardarraíl es nunca inventar urgencia.
# ESCALADO_REPORTES=10
# ESCALADO_MINUTOS=30
# ESCALADO_VENTANA_HORAS=6

# --- CRM (HubSpot) ---
# Solo lectura: la consola mira los tickets, no los crea. Sirve un Service Key
# (Development → Keys → Service Keys, `pat-na1-…`) o el token de una app
# privada (Settings → Integrations → Private Apps). NO es la "Developer API Key".
# Scopes necesarios: tickets, crm.objects.contacts.read.
HUBSPOT_TOKEN=

# --- Resumen de conversaciones (OPCIONAL) ---
# La vía preferida NO necesita esta clave: se declara una variable
# `resumenCorto` en el flujo de NL Pearl y el propio agente la redacta (en NL
# Pearl la `description` de una variable es el prompt). Si esa variable llega,
# se usa esa y nada más.
# Esta clave es solo el plan B, para conversaciones sin `resumenCorto`: la
# consola resume la transcripción por su cuenta. Sin ninguna de las dos, la
# tarjeta cae al texto crudo de NL Pearl recortado y lo marca "sin resumir".
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# --- Opcionales (tienen default sensato según el entorno) ---
# Respaldo JSON del Brain. Default: ./data/brain.json (local), /tmp/brain.json (serverless)
# BRAIN_DATA_FILE=./data/brain.json
# URL pública del gateway; el mock la usa para llamarse a sí mismo en local.
# En Vercel se deriva sola de VERCEL_URL.
# PUBLIC_BASE_URL=http://localhost:3000
# Duración de la "conversación" simulada. Default: 6000 local, 800 serverless.
# MOCK_CALL_DELAY_MS=6000
# Sembrar el directorio de demo al arrancar si el Brain está vacío.
# SEED_ON_BOOT=true

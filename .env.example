# Copiá este archivo a `.env` en la raíz del monorepo.
# Con MOCK=true todo corre simulado, sin credenciales.

# --- Modo ---
MOCK=true
PORT=3000

# --- NL Pearl v2 ---
# Auth: header `Authorization: Bearer {AccountId}:{SecretKey}` (confirmado en docs)
NLPEARL_BASE_URL=https://api.nlpearl.ai
NLPEARL_ACCOUNT_ID=
NLPEARL_API_KEY=
NLPEARL_PEARL_ID=
# Credential del webhook: NO lo da NL Pearl — lo creás VOS.
# El mismo valor va en dos lados: (1) NL Pearl → settings del Pearl →
# Webhooks → credential; (2) acá. Vacío = no se exige (modo dev/mock).
NLPEARL_WEBHOOK_SECRET=

# --- Canal de seguimiento post-llamada: whatsapp | sms ---
FOLLOWUP_CHANNEL=whatsapp

# --- Persistencia del Brain (memoria + respaldo JSON) ---
BRAIN_DATA_FILE=./data/brain.json
